<UserControl x:Class="FlibSystem.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Резервные копии" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="CreateBtn" Content="Создать копию" Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,8,0" Click="Create_Click" />
                <Button x:Name="RestoreBtn" Content="Восстановить" Style="{StaticResource DangerButtonStyle}"
                        Margin="0,0,8,0" Click="Restore_Click" />
                <Button Content="Открыть папку" Style="{StaticResource SecondaryButtonStyle}"
                        Click="OpenFolder_Click" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Перед применением твиков создаётся резервная копия всех затрагиваемых веток реестра (файлы .reg). Восстановление вернёт прежние значения."
                   Style="{StaticResource HintText}" Margin="0,0,0,10" />
        <TextBlock x:Name="Status" Text="" Style="{StaticResource HintText}" Margin="0,0,0,10" />

        <Border Style="{StaticResource Card}" Padding="8">
            <ListView x:Name="BackupList" Style="{StaticResource PlainListStyle}"
                      ItemContainerStyle="{StaticResource ListViewItemStyle}"
                      SelectionMode="Single">
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource GridColHeaderStyle}" />
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Копия" Width="220" DisplayMemberBinding="{Binding DisplayName}" />
                        <GridViewColumn Header="Создано" Width="160" DisplayMemberBinding="{Binding Created}" />
                        <GridViewColumn Header="Файлов .reg" Width="100" DisplayMemberBinding="{Binding FileCount}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </StackPanel>
</UserControl>

