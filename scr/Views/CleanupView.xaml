<UserControl x:Class="FlibSystem.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Очистка системы" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="AnalyzeBtn" Content="Анализ" Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,8,0" Click="Analyze_Click" />
                <Button x:Name="CleanBtn" Content="Очистить выбранное" Style="{StaticResource DangerButtonStyle}"
                        Click="Clean_Click" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Status" Text="Отметьте элементы и нажмите «Анализ» для подсчёта размера."
                   Style="{StaticResource HintText}" Margin="0,0,0,10" />

        <Border Style="{StaticResource Card}" Padding="8">
            <ListView x:Name="CleanList" Style="{StaticResource PlainListStyle}"
                      ItemContainerStyle="{StaticResource ListViewItemStyle}">
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource GridColHeaderStyle}" />
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="46">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Элемент" Width="230" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Тип" Width="80" DisplayMemberBinding="{Binding KindText}" />
                        <GridViewColumn Header="Размер" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="Путь" Width="420" DisplayMemberBinding="{Binding PathText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </StackPanel>
</UserControl>

