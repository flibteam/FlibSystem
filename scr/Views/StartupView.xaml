<UserControl x:Class="FlibSystem.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Автозагрузка" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="RefreshBtn" Content="Обновить" Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,8,0" Click="Refresh_Click" />
                <Button Content="Открыть папку" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="OpenFolder_Click" />
                <Button Content="Расположение файла" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="Reveal_Click" />
                <Button Content="Удалить" Style="{StaticResource DangerButtonStyle}"
                        Click="Remove_Click" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Программы, запускаемые при входе в систему. Переключатель работает по принципу диспетчера задач (StartupApproved) и полностью обратим."
                   Style="{StaticResource HintText}" Margin="0,0,0,10" />
        <TextBlock x:Name="Status" Text="" Style="{StaticResource HintText}" Margin="0,0,0,10" />

        <Border Style="{StaticResource Card}" Padding="8">
            <ListView x:Name="StartupList" Style="{StaticResource PlainListStyle}"
                      ItemContainerStyle="{StaticResource ListViewItemStyle}"
                      SelectionMode="Extended" MaxHeight="520">
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource GridColHeaderStyle}" />
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Вкл." Width="64">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Имя" Width="220" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Источник" Width="90" DisplayMemberBinding="{Binding SourceText}" />
                        <GridViewColumn Header="Команда" DisplayMemberBinding="{Binding Command}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </StackPanel>
</UserControl>