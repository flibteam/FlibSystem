<UserControl x:Class="FlibSystem.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlibSystem.Controls">
    <StackPanel>
        <TextBlock Text="Производительность" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
        <TextBlock Text="Включайте твики переключателем — изменения применяются мгновенно."
                   Style="{StaticResource HintText}" Margin="0,0,0,14" />
        <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:SettingRow Title="{Binding Name}"
                                         Description="{Binding Description}"
                                         Glyph="{Binding Glyph}"
                                         HasWarning="{Binding HasWarning}"
                                         IsOn="{Binding IsApplied, Mode=TwoWay}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

