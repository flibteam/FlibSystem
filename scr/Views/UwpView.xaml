<UserControl x:Class="FlibSystem.Views.UwpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Приложения (UWP)" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="RefreshBtn" Content="Обновить" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="Refresh_Click" />
                <Button Content="Выделить bloatware" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="SelectBloat_Click" />
                <Button x:Name="UninstallBtn" Content="Удалить выбранные" Style="{StaticResource DangerButtonStyle}"
                        Click="Uninstall_Click" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Список приложений из Microsoft Store. «Bloatware» — предустановленный мусор, который можно безопасно удалить."
                   Style="{StaticResource HintText}" Margin="0,0,0,10" />
        <TextBlock x:Name="Status" Text="Загрузка списка приложений..." Style="{StaticResource HintText}" Margin="0,0,0,10" />

        <Border Style="{StaticResource Card}" Padding="8">
            <ListView x:Name="AppList" Style="{StaticResource PlainListStyle}"
                      ItemContainerStyle="{StaticResource ListViewItemStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource GridColHeaderStyle}" />
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="46">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Имя" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Версия" Width="90" DisplayMemberBinding="{Binding Version}" />
                        <GridViewColumn Header="Издатель" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Publisher}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Publisher}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Расположение" Width="330">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding InstallLocation}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding InstallLocation}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </StackPanel>
</UserControl>

