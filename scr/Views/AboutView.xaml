<UserControl x:Class="FlibSystem.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="FlibSystem" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Утилита для тонкой настройки и персонализации Windows"
                           TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource HintText}" />
                <TextBlock Text="Версия 1.1.0 • .NET Framework 4.7.2 • WPF"
                           Margin="0,10,0,0" Style="{StaticResource HintText}" />
            </StackPanel>
        </Border>

        <TextBlock Text="Автор" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="flibteam (FlibSystem)" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
            </StackPanel>
        </Border>

        <TextBlock Text="Тема оформления" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />
        <Border Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="DarkThemeToggle" Style="{StaticResource ToggleSwitchStyle}"
                              VerticalAlignment="Center" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Тёмная тема" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Применяется сразу после переключения"
                               Style="{StaticResource HintText}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Обновления" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="UpdateStatusText" Text="Текущая версия: 1.0.0"
                           Style="{StaticResource HintText}" TextWrapping="Wrap" />
                <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,10,0,0"
                             Visibility="Collapsed" Maximum="100" />
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="CheckUpdateBtn" Content="Проверить обновления"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,10,0" Click="CheckUpdates_Click" />
                    <Button x:Name="DownloadUpdateBtn" Content="Скачать новую версию"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False" Margin="0,0,10,0" Click="DownloadUpdate_Click" />
                    <Button x:Name="OpenUpdateFolderBtn" Content="Открыть папку загрузок"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed" Click="OpenFolder_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Ссылки" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />
        <Border Style="{StaticResource Card}">
            <WrapPanel>
                <Button Content="GitHub" Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,10,10" Click="GitHub_Click"
                        ToolTip="https://github.com/flibteam" />
                <Button Content="Поддержать проект" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,10" Click="Donate_Click"
                        ToolTip="https://www.donationalerts.com/r/jannirobot" />
            </WrapPanel>
        </Border>
    </StackPanel>
</UserControl>