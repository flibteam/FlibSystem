<UserControl x:Class="FlibSystem.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <UserControl.Resources>
        <!-- Memory progress bar -->
        <Style x:Key="MemProgressBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Border Background="#15000000" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab button style -->
        <Style x:Key="TabBtn" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="14,6" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monitor nav item -->
        <Style x:Key="MonitorNavItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big metric value -->
        <Style x:Key="MetricBig" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ====== Header ====== -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tab switcher -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Диспетчер задач" Style="{StaticResource SectionTitle}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <ToggleButton x:Name="ProcsTabBtn" Style="{StaticResource TabBtn}" IsChecked="True"
                              Content="Процессы" Click="ProcsTab_Click"/>
                <ToggleButton x:Name="MonTabBtn" Style="{StaticResource TabBtn}"
                              Content="Мониторинг" Click="MonTab_Click"/>
            </StackPanel>

            <!-- Status + controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <CheckBox x:Name="AutoRefreshCb" Content="Авто" FontSize="12" VerticalAlignment="Center"
                          Margin="0,0,8,0" IsChecked="True" Checked="AutoRefresh_Changed"
                          Unchecked="AutoRefresh_Changed"/>
                <TextBlock x:Name="StatusText" Text="" Style="{StaticResource HintText}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="RefreshBtn" Content="↻" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,5" Click="Refresh_Click" Margin="0,0,4,0"
                        ToolTip="Обновить"/>
                <Button x:Name="KillBtn" Content="✕ Завершить" Style="{StaticResource DangerButtonStyle}"
                        Padding="10,5" Click="Kill_Click"/>
            </StackPanel>
        </Grid>

        <!-- ====== Process list tab ====== -->
        <Grid x:Name="ProcsPanel" Grid.Row="1">
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Process list -->
                    <ListView x:Name="ProcList" Grid.Row="0"
                              Style="{StaticResource PlainListStyle}"
                              ItemContainerStyle="{StaticResource ListViewItemStyle}"
                              SelectionMode="Extended" VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.IsDeferredScrollingEnabled="True"
                              KeyDown="ProcList_KeyDown">
                        <ListView.Resources>
                            <Style TargetType="{x:Type GridViewColumnHeader}"
                                   BasedOn="{StaticResource GridColHeaderStyle}"/>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <!-- Name + Icon -->
                                <GridViewColumn Header="Имя" Width="260">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" FontSize="13"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- PID -->
                                <GridViewColumn Header="PID" Width="65"
                                                DisplayMemberBinding="{Binding Id}"/>
                                <!-- CPU -->
                                <GridViewColumn Header="CPU %" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CpuText}" VerticalAlignment="Center"
                                                       FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource PrimaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CpuPercent}"
                                                                         Value="0">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource SecondaryTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Memory bar -->
                                <GridViewColumn Header="Память" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding MemoryText}" FontSize="11"
                                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <ProgressBar Grid.Column="1" Value="{Binding MemoryPercent}"
                                                             Style="{StaticResource MemProgressBar}"
                                                             Margin="8,0,0,0" VerticalAlignment="Center"
                                                             Maximum="100"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Threads -->
                                <GridViewColumn Header="Потоков" Width="70"
                                                DisplayMemberBinding="{Binding Threads}"/>
                                <!-- Status: protected -->
                                <GridViewColumn Header="Тип" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProtected}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                                <Setter Property="Text" Value="Системный"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Bottom bar: filters + summary -->
                    <Border Grid.Row="1" Padding="14,10"
                            BorderBrush="{StaticResource HeaderBorderBrush}" BorderThickness="0,1,0,0"
                            Background="#08FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ProcCountText" Style="{StaticResource HintText}"
                                           Text="Процессов: —" VerticalAlignment="Center"/>
                                <TextBlock Text="  ·  " Style="{StaticResource HintText}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProcMemText" Style="{StaticResource HintText}"
                                           Text="Память: —" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Фильтр памяти:" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="MemFilterCombo" Width="140" FontSize="12"
                                          SelectionChanged="MemFilter_Changed">
                                    <ComboBoxItem Content="Все" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="От 50 МБ" Tag="50"/>
                                    <ComboBoxItem Content="От 100 МБ" Tag="100"/>
                                    <ComboBoxItem Content="От 300 МБ" Tag="300"/>
                                    <ComboBoxItem Content="От 500 МБ" Tag="500"/>
                                    <ComboBoxItem Content="От 1 ГБ" Tag="1024"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ====== Monitor tab ====== -->
        <Grid x:Name="MonPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left nav -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,10,0">
                <ListBox x:Name="MonNavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource MonitorNavItem}"
                         SelectionChanged="MonNav_SelectionChanged">
                    <ListBoxItem x:Name="NavCpu" Tag="Cpu" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ЦП" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CpuNavValue" Grid.Column="1" Text="—"
                                       FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavRam" Tag="Ram">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ОЗУ" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="RamNavValue" Grid.Column="1" Text="—"
                                       FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavNet" Tag="Net">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Сеть" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="NetNavValue" Grid.Column="1" Text="—"
                                       FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavDisk" Tag="Disk">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Диск" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="DiskNavValue" Grid.Column="1" Text="—"
                                       FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavGpu" Tag="Gpu">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ГПУ" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="GpuNavValue" Grid.Column="1" Text="—"
                                       FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Right panel: metric detail -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="20,16,20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- CPU panel -->
                        <StackPanel x:Name="CpuDetailPanel" Grid.Row="0">
                            <TextBlock Text="Центральный процессор" FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CpuBigValue" Style="{StaticResource MetricBig}"
                                           Text="— %"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="CpuFreqValue" Style="{StaticResource MetricLabel}"
                                               Text="— MHz"/>
                                    <TextBlock x:Name="CpuBaseValue" Style="{StaticResource MetricLabel}"
                                               Text="Базовая — MHz"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom">
                                    <TextBlock x:Name="CpuProcessesValue" Style="{StaticResource MetricLabel}"
                                               Text="Процессов: —" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="CpuUptimeValue" Style="{StaticResource MetricLabel}"
                                               Text="Работа: —" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            <!-- CPU graph -->
                            <Border Background="#08000000" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,10">
                                <Grid Height="150">
                                    <Canvas x:Name="CpuGraphCanvas" ClipToBounds="True"/>
                                </Grid>
                            </Border>
                            <!-- Per-core bars -->
                            <TextBlock Text="Загрузка ядер" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <ItemsControl x:Name="CpuCoresPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="100" Margin="0,0,8,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                                <Border Background="#15000000" CornerRadius="2"/>
                                                <Border CornerRadius="2"
                                                        HorizontalAlignment="Left"
                                                        Background="{StaticResource AccentBrush}"
                                                        Width="{Binding BarWidth}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- RAM panel -->
                        <StackPanel x:Name="RamDetailPanel" Grid.Row="1" Visibility="Collapsed">
                            <TextBlock Text="Оперативная память" FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RamBigValue" Style="{StaticResource MetricBig}"
                                           Text="— %"/>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom">
                                    <TextBlock x:Name="RamUsedValue" Style="{StaticResource MetricLabel}"
                                               Text="Используется — / — ГБ"/>
                                    <TextBlock x:Name="RamTotalValue" Style="{StaticResource MetricLabel}"
                                               Text="Всего — ГБ"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="#08000000" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <Grid Height="150">
                                    <Canvas x:Name="RamGraphCanvas" ClipToBounds="True"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Network panel -->
                        <StackPanel x:Name="NetDetailPanel" Grid.Row="2" Visibility="Collapsed">
                            <TextBlock Text="Сеть" FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Загрузка" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="NetBigDown" Style="{StaticResource MetricBig}"
                                               Text="— Мбит/с" FontSize="24"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Отдача" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="NetBigUp" Style="{StaticResource MetricBig}"
                                               Text="— Мбит/с" FontSize="24"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="#08000000" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <Grid Height="150">
                                    <Canvas x:Name="NetGraphCanvas" ClipToBounds="True"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Disk panel -->
                        <StackPanel x:Name="DiskDetailPanel" Grid.Row="3" Visibility="Collapsed">
                            <TextBlock Text="Диск" FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="DiskBigValue" Style="{StaticResource MetricBig}"
                                       Text="— %" Margin="0,0,0,10"/>
                            <Border Background="#08000000" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <Grid Height="150">
                                    <Canvas x:Name="DiskGraphCanvas" ClipToBounds="True"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- GPU panel -->
                        <StackPanel x:Name="GpuDetailPanel" Grid.Row="4" Visibility="Collapsed">
                            <TextBlock Text="Видеокарта" FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GpuBigValue" Style="{StaticResource MetricBig}"
                                           Text="— %"/>
                                <TextBlock x:Name="GpuMemValue" Grid.Column="1"
                                           Style="{StaticResource MetricLabel}"
                                           Text="Видеопамять: — / —" VerticalAlignment="Bottom"
                                           Margin="16,0,0,0"/>
                            </Grid>
                            <Border Background="#08000000" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <Grid Height="150">
                                    <Canvas x:Name="GpuGraphCanvas" ClipToBounds="True"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
