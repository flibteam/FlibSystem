<UserControl x:Class="FlibSystem.Controls.SettingRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root"
             Margin="0,0,0,8">
    <Border Style="{StaticResource Card}">
        <Grid>
<Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                    Background="{DynamicResource AccentDarkBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph, ElementName=root}"
                           FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title, ElementName=root}"
                               FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{DynamicResource WarningBrush}"
                               Margin="6,1,0,0"
                               ToolTip="Внимание: данный твик может снизить безопасность или требует перезагрузки"
                               Visibility="{Binding HasWarning, ElementName=root, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding Description, ElementName=root}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>

            <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding IsOn, ElementName=root, Mode=TwoWay}"
                          IsEnabled="{Binding IsToggleEnabled, ElementName=root}"
                          VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>

